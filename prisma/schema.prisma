// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  name                  String
  email                 String    @unique
  password              String
  active                Boolean   @default(true)
  role                  String    @default("CUSTOMER")
  emailVerified         Boolean   @default(false) @map("email_verified")
  verificationToken     String?   @map("verification_token")
  resetPasswordToken    String?   @map("reset_password_token")
  resetPasswordExpires  DateTime? @map("reset_password_expires")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  orders                Order[]

  @@index([verificationToken])
  @@index([resetPasswordToken])
  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  image       String?   @db.LongText
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("categories")
}

model Product {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  sku              String         @unique
  description      String?        @db.Text
  price            Decimal        @db.Decimal(10, 2)
  promotionalPrice Decimal?       @map("promotional_price") @db.Decimal(10, 2)
  stock            Int            @default(0)
  status           Boolean        @default(true)
  gender           String         @default("Masculino")
  highlight        Boolean        @default(false)
  newLaunch        Boolean        @default(false) @map("new_launch")
  composition      String?        @db.Text
  fit              String?
  washCare         String?        @map("wash_care") @db.Text
  sizes            Json?
  colors           Json?

  categoryId       String         @map("category_id")
  category         Category       @relation(fields: [categoryId], references: [id])

  images           ProductImage[]

  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String   @db.LongText
  isMain    Boolean  @default(false) @map("is_main")
  order     Int      @default(0)

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number")
  customerName    String        @map("customer_name")
  customerEmail   String        @map("customer_email")
  customerCpf     String        @map("customer_cpf")
  customerPhone   String        @map("customer_phone")
  
  // Shipping Address
  postalCode      String        @map("postal_code")
  street          String
  number          String
  complement      String?
  neighborhood    String
  city            String
  state           String
  
  // Financial
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingCost    Decimal       @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  
  // Payment info
  paymentMethod   PaymentMethod @map("payment_method")
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  
  // Asaas specifics
  asaasCustomerId String?       @map("asaas_customer_id")
  asaasPaymentId  String?       @map("asaas_payment_id")
  pixQrCodeImage  String?       @map("pix_qrcode_image") @db.LongText
  pixCopiaECola   String?       @map("pix_copia_e_cola") @db.Text
  pixExpiresAt    DateTime?     @map("pix_expires_at")
  installments    Int?          @default(1)
  
  customerNotes   String?       @map("customer_notes") @db.Text

  userId          String?       @map("user_id")
  user            User?         @relation(fields: [userId], references: [id])
  
  items           OrderItem[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@index([asaasPaymentId])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId   String?  @map("product_id")
  name        String
  sku         String?
  image       String?  @db.LongText
  size        String?
  color       String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  total       Decimal  @db.Decimal(10, 2)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
