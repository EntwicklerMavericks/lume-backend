# Database (MySQL 8.0)
DATABASE_URL="mysql://root:123mudar@localhost:3306/lume_store"

# JWT Auth
JWT_SECRET="sua_chave_super_secreta_lume_store_jwt_token_2026"
JWT_EXPIRES_IN="1d"

# Server
PORT=3000
ALLOWED_ORIGINS="http://localhost:4200,http://localhost:4300,http://localhost:8080"

# Asaas Payment Gateway
# Crie sua conta de testes gratuita em: https://sandbox.asaas.com
# Gere sua chave de API em: Configuracoes > Integracoes > Chave de API
ASAAS_API_KEY="$aact_sua_chave_de_api_sandbox_ou_producao"
ASAAS_ENVIRONMENT="sandbox"
ASAAS_WEBHOOK_TOKEN="lume_asaas_webhook_secret_2026"

# ==============================================================================
# E-MAILS TRANSACIONAIS (OPCIONAL - Pedidos, PIX, Aprovação e Rastreio)
# Se não configurado, o sistema apenas registra no console sem travar vendas.
# ==============================================================================

# OPÇÃO A: Resend (Recomendado - Gratuito até 3.000 e-mails/mês em https://resend.com)
RESEND_API_KEY="re_sua_chave_de_api_aqui"
RESEND_FROM_EMAIL="pedidos@seudominio.com.br"

# OPÇÃO B: SMTP Clássico (Hostinger, Titan, Locaweb, cPanel, Gmail Workspace)
# Ativo automaticamente caso RESEND_API_KEY não esteja configurado
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=587
SMTP_USER="contato@seudominio.com.br"
SMTP_PASS="sua_senha_do_email"
SMTP_SECURE=false
SMTP_FROM_EMAIL="contato@seudominio.com.br"
